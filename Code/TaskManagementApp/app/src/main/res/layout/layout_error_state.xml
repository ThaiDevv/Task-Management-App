<?xml version="1.0" encoding="utf-8"?>
<!--
    Error State — reusable full-screen overlay.
    Included by fragment_task_list.xml and shown when UiState is Error.
    The message TextView is populated dynamically from UiState.Error.message.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Soft circular icon container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardBackgroundColor="@color/error_container"
        app:cardCornerRadius="48dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/error"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/state_error_generic"
            android:src="@drawable/ic_error"
            app:tint="@color/error" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Error title -->
    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/state_error_title"
        android:textColor="@color/on_background"
        android:textSize="18sp" />

    <!-- Dynamic error message (set from UiState.Error.message) -->
    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/state_error_generic"
        android:textColor="@color/outline"
        android:textSize="14sp" />

    <!-- Retry button -->
    <Button
        android:id="@+id/btnErrorRetry"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_error_button"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.02"
        android:minWidth="160dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/action_retry"
        android:textColor="@color/on_error_container"
        android:textSize="14sp"
        app:cornerRadius="16dp" />
</LinearLayout>
