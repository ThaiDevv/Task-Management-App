<?xml version="1.0" encoding="utf-8"?>
<!--
    Loading State — reusable full-screen overlay.
    Included by fragment_task_list.xml and shown when UiState is Loading.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Material circular progress indicator (no shimmer library needed) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/primary"
        app:indicatorSize="48dp"
        app:trackColor="@color/primary_fixed_dim"
        app:trackThickness="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/state_loading"
        android:textColor="@color/outline"
        android:textSize="14sp" />
</LinearLayout>
