<?xml version="1.0" encoding="utf-8"?>
<!--
    Empty State — reusable full-screen overlay.
    Included by fragment_task_list.xml and shown when UiState is Empty.
    Contains a CTA button to create a new task.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Soft circular icon container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardBackgroundColor="@color/surface_container_low"
        app:cardCornerRadius="48dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/state_empty_tasks"
            android:src="@drawable/ic_add_task"
            app:tint="@color/primary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty state title -->
    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/state_empty_tasks"
        android:textColor="@color/on_background"
        android:textSize="18sp" />

    <!-- Empty state subtitle -->
    <TextView
        android:id="@+id/tvEmptySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/state_empty_subtitle"
        android:textColor="@color/outline"
        android:textSize="14sp" />

    <!-- CTA: Create new task -->
    <Button
        android:id="@+id/btnEmptyCreateTask"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.02"
        android:minWidth="200dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/state_empty_create_button"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        app:cornerRadius="16dp" />
</LinearLayout>
