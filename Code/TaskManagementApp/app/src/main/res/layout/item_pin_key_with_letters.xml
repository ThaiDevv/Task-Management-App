<?xml version="1.0" encoding="utf-8"?>
<!--
    item_pin_key_with_letters.xml — Nút bàn phím số PIN chuẩn hình tròn phẳng hoàn hảo (76dp × 76dp).
    Sử dụng shape="oval" và ripple không elevation để loại bỏ 100% vệt bóng/đường gạch ở đáy nút.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pinKeyCard"
    android:layout_width="76dp"
    android:layout_height="76dp"
    android:background="@drawable/bg_pin_key_circle"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/pinKeyRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Số chính: font Poppins Bold 30sp, màu primary (#0045AE) -->
        <TextView
            android:id="@+id/tvKeyNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="30sp"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:gravity="center"
            tools:text="2" />

        <!-- Chữ cái phụ: font Poppins Medium 10sp, màu outline (#737786) -->
        <TextView
            android:id="@+id/tvKeyLetters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/outline"
            android:textSize="10sp"
            android:fontFamily="@font/poppins_medium"
            android:letterSpacing="0.15"
            android:includeFontPadding="false"
            android:gravity="center"
            android:layout_marginTop="1dp"
            tools:text="ABC" />
    </LinearLayout>
</FrameLayout>
