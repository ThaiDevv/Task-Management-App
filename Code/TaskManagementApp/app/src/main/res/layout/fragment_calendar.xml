<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    tools:context=".ui.CalendarFragment">

    <!-- Top AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:background="?attr/colorSurface"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_calendar"
            android:textSize="@dimen/text_headline_large"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="@font/poppins_semibold"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/userAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_account"
            android:background="@drawable/bg_avatar"
            android:contentDescription="User Avatar"
            android:scaleType="centerCrop"
            android:clipToOutline="true" />

    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Month Selector with Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/spacing_12"
                android:paddingBottom="@dimen/spacing_12"
                android:background="@drawable/bg_month_selector"
                android:layout_marginBottom="@dimen/spacing_16">

                <ImageButton
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="@dimen/touch_target_minimum"
                    android:layout_height="@dimen/touch_target_minimum"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="Previous Month"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/outline" />

                <TextView
                    android:id="@+id/monthYearText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="October 2024"
                    android:textSize="@dimen/text_headline_medium"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="@font/poppins_semibold"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageButton
                    android:id="@+id/btnNextMonth"
                    android:layout_width="@dimen/touch_target_minimum"
                    android:layout_height="@dimen/touch_target_minimum"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Next Month"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/outline" />

            </LinearLayout>

            <!-- Calendar Widget -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_calendar_container"
                android:padding="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_24">

                <!-- Day Headers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_12">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="S"
                        android:textSize="@dimen/text_label_medium"
                        android:textColor="@color/outline"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="M"
                        android:textSize="@dimen/text_label_medium"
                        android:textColor="@color/outline"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="T"
                        android:textSize="@dimen/text_label_medium"
                        android:textColor="@color/outline"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="W"
                        android:textSize="@dimen/text_label_medium"
                        android:textColor="@color/outline"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="T"
                        android:textSize="@dimen/text_label_medium"
                        android:textColor="@color/outline"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="F"
                        android:textSize="@dimen/text_label_medium"
                        android:textColor="@color/outline"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="S"
                        android:textSize="@dimen/text_label_medium"
                        android:textColor="@color/outline"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Calendar Days Grid -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="7"
                    app:rowCount="6" />

            </LinearLayout>

            <!-- Schedule Title -->
            <TextView
                android:id="@+id/scheduleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_schedule"
                android:textSize="@dimen/text_headline_medium"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/poppins_semibold"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_16" />

            <!-- Schedule Tasks List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scheduleRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_calendar_task" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/emptyScheduleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/state_empty_tasks"
                android:textSize="@dimen/text_body_medium"
                android:textColor="@color/outline"
                android:fontFamily="@font/poppins_regular"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_32"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
