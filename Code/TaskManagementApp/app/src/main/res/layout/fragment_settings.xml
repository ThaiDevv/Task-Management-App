<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    tools:context=".ui.SettingsFragment">

    <!-- Top AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:background="?attr/colorSurface"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_security"
            android:textSize="@dimen/text_headline_large"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="@font/poppins_semibold"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_24">

            <!-- PIN Lock Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_16"
                android:paddingBottom="@dimen/spacing_16"
                android:background="@color/surface_container_lowest"
                android:layout_marginBottom="@dimen/spacing_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_pin_lock"
                            android:textSize="@dimen/text_headline_medium"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/poppins_semibold"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_pin_desc"
                            android:textSize="@dimen/text_body_small"
                            android:textColor="@color/outline"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/spacing_4" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/pinLockSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

                <!-- PIN Settings Group -->
                <LinearLayout
                    android:id="@+id/pinSettingsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_16">

                    <!-- Change PIN Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/spacing_12"
                        android:paddingEnd="@dimen/spacing_12"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_12"
                        android:background="@color/surface_container_low"
                        android:layout_marginBottom="@dimen/spacing_8">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:src="@drawable/ic_nav_settings"
                            android:contentDescription="@null"
                            android:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:text="@string/settings_change_pin"
                            android:textSize="@dimen/text_body_medium"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit"
                            android:textSize="@dimen/text_body_medium"
                            android:textColor="?attr/colorPrimary"
                            android:fontFamily="@font/poppins_semibold"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Biometric Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/spacing_12"
                        android:paddingEnd="@dimen/spacing_12"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_12"
                        android:background="@color/surface_container_low"
                        android:layout_marginBottom="@dimen/spacing_8">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_biometric"
                                android:textSize="@dimen/text_body_medium"
                                android:textColor="?attr/colorOnSurface"
                                android:fontFamily="@font/poppins_medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_biometric_desc"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="@color/outline"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginTop="@dimen/spacing_2" />

                        </LinearLayout>

                        <Switch
                            android:id="@+id/biometricSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                    <!-- Auto-lock Dropdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/spacing_12"
                        android:paddingEnd="@dimen/spacing_12"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_12"
                        android:background="@color/surface_container_low">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_auto_lock"
                                android:textSize="@dimen/text_body_medium"
                                android:textColor="?attr/colorOnSurface"
                                android:fontFamily="@font/poppins_medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_auto_lock_desc"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="@color/outline"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginTop="@dimen/spacing_2" />

                        </LinearLayout>

                        <Spinner
                            android:id="@+id/autoLockSpinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Critical Actions Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_16"
                android:paddingBottom="@dimen/spacing_16"
                android:background="@color/error_container">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_critical_actions"
                    android:textSize="@dimen/text_headline_medium"
                    android:textColor="@color/error"
                    android:fontFamily="@font/poppins_semibold"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_12" />

                <!-- Logout Button -->
                <Button
                    android:id="@+id/logoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_logout_all"
                    android:textColor="@color/error"
                    android:background="@drawable/bg_error_button"
                    android:layout_marginBottom="@dimen/spacing_8"
                    android:fontFamily="@font/poppins_medium" />

                <!-- Deactivate Button -->
                <Button
                    android:id="@+id/deactivateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_deactivate_vault"
                    android:textColor="@color/error"
                    android:background="@drawable/bg_error_button"
                    android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
