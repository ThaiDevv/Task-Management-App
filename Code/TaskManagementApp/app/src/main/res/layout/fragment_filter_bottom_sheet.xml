<?xml version="1.0" encoding="utf-8"?>
<!--
  Filter & Sort Bottom Sheet
  Faithfully reproduces the TaskFlow reference design:
  • rounded-t-[32dp] white card + gray drag handle
  • STATUS: label–checkbox rows (Todo / Completed / Overdue)
  • PRIORITY: equal-width pill chips in one row (High / Medium / Low)
  • SORT BY: label–radio rows (Due date ↑ / Due date ↓ / Priority)
  • Apply Filters: full-width #105CDB button h=56dp rounded-[16dp]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filter_sheet"
    android:orientation="vertical">

    <!-- ── Drag Handle (w-12 h-1.5 bg-outline-variant rounded-full) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal">

        <View
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_filter_handle" />
    </LinearLayout>

    <!-- ── Scrollable content ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- ── Header: "Filter & Sort"  +  Reset ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/filter_title"
                    android:textColor="#1B1B1B"
                    android:textSize="28sp"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/btnReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/filter_reset"
                    android:textColor="#105CDB"
                    android:textSize="15sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ════════════════════════════════════
                 STATUS SECTION
            ════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.12"
                android:text="@string/filter_section_status"
                android:textAllCaps="true"
                android:textColor="#737786"
                android:textSize="11sp" />

            <!-- Todo row -->
            <LinearLayout
                android:id="@+id/statusTodo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/filter_status_todo"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbStatusTodo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#0045AE" />
            </LinearLayout>

            <!-- Completed row -->
            <LinearLayout
                android:id="@+id/statusCompleted"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/filter_status_completed"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbStatusCompleted"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#0045AE" />
            </LinearLayout>

            <!-- Overdue row -->
            <LinearLayout
                android:id="@+id/statusOverdue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/filter_status_overdue"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbStatusOverdue"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#0045AE" />
            </LinearLayout>

            <!-- ════════════════════════════════════
                 PRIORITY SECTION
                 Equal-width pills: High | Medium | Low
                 (flex-wrap gap-3, rounded-2xl, border → bg-primary when selected)
            ════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.12"
                android:text="@string/filter_section_priority"
                android:textAllCaps="true"
                android:textColor="#737786"
                android:textSize="11sp" />

            <!-- Row 1: High · Medium · Low -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPriorityHigh"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_filter_chip_selector"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="@string/filter_priority_high"
                    android:textColor="#1B1B1B"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipPriorityMedium"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_filter_chip_selector"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="@string/filter_priority_medium"
                    android:textColor="#1B1B1B"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipPriorityLow"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_chip_selector"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="@string/filter_priority_low"
                    android:textColor="#1B1B1B"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ════════════════════════════════════
                 SORT BY SECTION
                 Visual style as STATUS — label left, RadioButton right
            ════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.12"
                android:text="@string/filter_section_sort_by"
                android:textAllCaps="true"
                android:textColor="#737786"
                android:textSize="11sp" />

            <!-- Due date asc -->
            <LinearLayout
                android:id="@+id/sortDueDateAsc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/sort_due_date_asc"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbSortDueDateAsc"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#0045AE" />
            </LinearLayout>

            <!-- Due date desc -->
            <LinearLayout
                android:id="@+id/sortDueDateDesc"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/sort_due_date_desc"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbSortDueDateDesc"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#0045AE" />
            </LinearLayout>

            <!-- Priority sort -->
            <LinearLayout
                android:id="@+id/sortPriority"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/sort_priority"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbSortPriority"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="#0045AE" />
            </LinearLayout>

            <!-- ── Apply Filters Button ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyFilter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/filter_apply"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="#105CDB"
                app:cornerRadius="16dp"
                app:elevation="0dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
