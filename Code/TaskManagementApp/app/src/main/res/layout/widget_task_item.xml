<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng task trên widget: priority stripe bo tròn bên trái, tiêu đề + giờ,
     checkbox hoàn thành bên phải (click để toggle). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:background="@drawable/widget_item_background">

    <!-- RemoteViews không cho inflate android.view.View trần — phải dùng ImageView. -->
    <ImageView
        android:id="@+id/widget_item_priority_stripe"
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_priority_stripe_medium"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_item_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:textColor="@color/widget_on_surface"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/widget_ic_clock"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/poppins_regular"
                android:textSize="11sp"
                android:textColor="@color/widget_on_surface_variant"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_item_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/widget_ic_check_circle_outline"
        android:contentDescription="@string/widget_mark_done"
        android:scaleType="fitCenter" />
</LinearLayout>
