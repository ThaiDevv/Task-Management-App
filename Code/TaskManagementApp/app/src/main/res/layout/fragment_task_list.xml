<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.TaskListFragment">

    <!-- Content with ScrollView to handle overflow -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_24"
            android:paddingBottom="@dimen/spacing_96">

            <!-- Greeting Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24"
                android:paddingBottom="@dimen/spacing_24">

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_greeting_prefix"
                    android:textSize="@dimen/text_label_small"
                    android:textColor="@color/outline"
                    android:fontFamily="@font/poppins_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello, Alex!"
                    android:textSize="@dimen/text_display_medium"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_4" />

            </LinearLayout>

            <!-- Summary Metrics Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24"
                android:paddingBottom="@dimen/spacing_24">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:columnOrderPreserved="false">

                    <!-- Total Tasks Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_row="0"
                        android:layout_column="0"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:layout_marginBottom="@dimen/spacing_8"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface_container_lowest">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_total_tasks"
                                android:textSize="@dimen/text_label_small"
                                android:textColor="@color/outline"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/totalTasksValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="24"
                                android:textSize="32sp"
                                android:textColor="?attr/colorOnSurface"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_8" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Completed Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_row="0"
                        android:layout_column="1"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_marginBottom="@dimen/spacing_8"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface_container_lowest">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_completed"
                                android:textSize="@dimen/text_label_small"
                                android:textColor="@color/outline"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/completedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18"
                                android:textSize="32sp"
                                android:textColor="?attr/colorOnSurface"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_8" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Pending Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_row="1"
                        android:layout_column="0"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:layout_marginTop="@dimen/spacing_8"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface_container_lowest">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_pending"
                                android:textSize="@dimen/text_label_small"
                                android:textColor="@color/outline"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/pendingValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textSize="32sp"
                                android:textColor="?attr/colorOnSurface"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_8" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Overdue Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_row="1"
                        android:layout_column="1"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_marginTop="@dimen/spacing_8"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface_container_lowest">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_overdue"
                                android:textSize="@dimen/text_label_small"
                                android:textColor="@color/outline"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/overdueValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:textSize="32sp"
                                android:textColor="@color/error"
                                android:fontFamily="@font/poppins_bold"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_8" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </GridLayout>

            </LinearLayout>

            <!-- Today's Tasks Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_16">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_todays_tasks"
                        android:textSize="@dimen/text_headline_large"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/poppins_bold"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_view_all"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="?attr/colorPrimary"
                        android:fontFamily="@font/poppins_semibold"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Tasks RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tasksRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_task_summary" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/state_empty_tasks"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/outline"
                    android:textAlignment="center"
                    android:layout_marginTop="@dimen/spacing_32"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Floating Action Button for Create Task -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_24"
        android:contentDescription="@string/action_create_task"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="@color/on_primary"
        app:elevation="8dp" />

</FrameLayout>
