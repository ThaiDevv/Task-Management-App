<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout: fragment_data_management.xml
  TASK-26 / TASK-54 — pixel-perfect theo design data_management_polished/screen.png
  Thứ tự sections: Export → Restore → Status Card → Recent Backups
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".ui.DataManagementFragment">

    <!-- ─── Top App Bar ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="#1A1A2E" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="TaskFlow"
            android:textColor="#3D5AFE"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- ─── Scrollable body ─── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp">

            <!-- ─ Page title ─ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/data_management_title"
                android:textColor="#1A1A2E"
                android:textSize="28sp"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/data_management_subtitle"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- ═══════════════════════════════════════════
                 SECTION 1 — Export Data card
             ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Icon + title/subtitle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Square icon container (light blue bg) -->
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_box_primary"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_settings_backup"
                            app:tint="#3D5AFE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/data_export_title"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/data_export_summary"
                                android:textColor="#6B7280"
                                android:textSize="13sp"
                                android:lineSpacingMultiplier="1.3" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Stat chips: Total Tasks | Completed -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Total Tasks chip -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_chip"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:letterSpacing="0.1"
                                android:text="@string/data_export_total_tasks"
                                android:textColor="#9CA3AF"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTotalTasksCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="–"
                                android:textColor="#1A1A2E"
                                android:textSize="28sp"
                                tools:text="24" />

                        </LinearLayout>

                        <!-- Completed chip -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_chip"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:letterSpacing="0.1"
                                android:text="@string/data_export_completed"
                                android:textColor="#9CA3AF"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvCompletedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="–"
                                android:textColor="#1565C0"
                                android:textSize="28sp"
                                tools:text="12" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Export to JSON button (full-width, solid blue) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exportDataButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/data_export_action"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:backgroundTint="#3D5AFE"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_settings_backup"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#FFFFFF" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 SECTION 2 — Restore Data card
             ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Icon + title/subtitle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_box_secondary"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_settings_restore"
                            app:tint="#3D5AFE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/data_restore_title"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/data_restore_summary"
                                android:textColor="#6B7280"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Dashed drop-zone -->
                    <LinearLayout
                        android:id="@+id/dropZone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_upload_dropzone"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="28dp"
                        android:paddingBottom="28dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <!-- Cloud upload icon in circle -->
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_cloud_icon_circle">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_cloud_upload"
                                app:tint="#9CA3AF" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:text="@string/data_restore_upload_hint"
                            android:textColor="#1A1A2E"
                            android:textSize="16sp"
                            android:lineSpacingMultiplier="1.3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:text="@string/data_restore_upload_sub"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- File preview row (hidden until file selected) -->
                    <LinearLayout
                        android:id="@+id/layoutFilePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_file_json"
                            app:tint="#3D5AFE" />

                        <TextView
                            android:id="@+id/tvSelectedFileName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:fontFamily="@font/poppins_regular"
                            android:singleLine="true"
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            tools:text="taskflow_backup_2025.json" />

                        <ImageButton
                            android:id="@+id/btnClearFile"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/data_restore_cancel"
                            android:padding="4dp"
                            android:src="@drawable/ic_delete"
                            app:tint="#9CA3AF" />

                    </LinearLayout>

                    <!-- Choose Backup File button (outlined) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restoreDataButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/data_restore_action"
                        android:textAllCaps="false"
                        android:textColor="#3D5AFE"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_settings_restore"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#3D5AFE"
                        app:strokeColor="#3D5AFE" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════
                 SECTION 3 — Latest Status (blue gradient card)
             ═══════════════════════════════════════════ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardBackupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_backup_status_card"
                android:padding="20dp">

                <!-- Check icon top-left -->
                <ImageView
                    android:id="@+id/ivStatusBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#90CAF9" />

                <!-- LATEST STATUS label -->
                <TextView
                    android:id="@+id/tvLatestStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:letterSpacing="0.1"
                    android:text="@string/data_latest_status_label"
                    android:textColor="#90CAF9"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="@id/ivStatusBadge"
                    app:layout_constraintStart_toEndOf="@id/ivStatusBadge"
                    app:layout_constraintTop_toTopOf="@id/ivStatusBadge" />

                <!-- Status title -->
                <TextView
                    android:id="@+id/tvBackupStatusTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/data_last_backup_success"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:lineSpacingMultiplier="1.2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLatestStatusLabel" />

                <!-- Timestamp subtitle -->
                <TextView
                    android:id="@+id/tvBackupStatusSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text=""
                    android:textColor="#BBDEFB"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBackupStatusTitle"
                    tools:text="Today at 10:42 AM • 1.2 MB" />

                <!-- Action buttons: Download Last | Verify Integrity -->
                <LinearLayout
                    android:id="@+id/layoutStatusActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBackupStatusSub">

                    <TextView
                        android:id="@+id/btnDownloadLast"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_status_card_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/data_download_last"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnVerifyIntegrity"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_status_card_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/data_verify_integrity"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ═══════════════════════════════════════════
                 SECTION 4 — Recent Backups
             ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/data_recent_backups"
                            android:textColor="#1A1A2E"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_repeat"
                            app:tint="#6B7280" />

                    </LinearLayout>

                    <!-- Backup item 1 -->
                    <include
                        android:id="@+id/recentItem1"
                        layout="@layout/item_backup_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" />

                    <!-- Backup item 2 -->
                    <include
                        android:id="@+id/recentItem2"
                        layout="@layout/item_backup_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <!-- Backup item 3 -->
                    <include
                        android:id="@+id/recentItem3"
                        layout="@layout/item_backup_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <!-- Backup item 4 -->
                    <include
                        android:id="@+id/recentItem4"
                        layout="@layout/item_backup_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#F3F4F6" />

                    <!-- View All History link -->
                    <LinearLayout
                        android:id="@+id/btnViewAllHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/data_view_all_history"
                            android:textColor="#3D5AFE"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="#3D5AFE" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom spacer -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
