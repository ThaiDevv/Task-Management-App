<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.StatsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar: Statistics Title & Circular Filter Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStatsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/stats_title"
                android:textColor="@color/on_surface"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_semibold" />

            <!-- Circular Filter Button -->
            <ImageButton
                android:id="@+id/btnFilterStats"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_filter_list"
                android:contentDescription="@string/stats_filter"
                app:tint="@color/on_surface_variant" />
        </RelativeLayout>

        <!-- Main Scrollable Bento Grid Canvas -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16">

                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <!-- Bento Card 1: Weekly Productivity (Full width)                      -->
                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWeeklyProductivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F0F0F0"
                    app:cardBackgroundColor="@color/surface_container_lowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvWeeklyProductivityTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_completion_by_weekday"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:id="@+id/tvWeeklyProductivitySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/stats_this_week"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular" />

                        <!-- Weekly Productivity Chart View -->
                        <com.team.taskmanagementapp.ui.custom.WeeklyProductivityChartView
                            android:id="@+id/chartWeeklyProductivity"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <!-- Bento Row 2: Completion Rate (Left) & Stacked Stats (Right)        -->
                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Left Card: Completion Rate -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCompletionRate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#F0F0F0"
                        app:cardBackgroundColor="@color/surface_container_lowest">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_completion_rate"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                android:fontFamily="@font/poppins_medium" />

                            <com.team.taskmanagementapp.ui.custom.CircularCompletionRateView
                                android:id="@+id/viewCompletionRate"
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp" />

                            <TextView
                                android:id="@+id/tvCompletionRateStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_on_track"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                android:fontFamily="@font/poppins_regular" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Right Stack: Completed Card & Deep Work Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <!-- Completed Card (Top) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardCompleted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="#0045AE">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="true">

                                <!-- Faded Watermark Checkmark Icon -->
                                <ImageView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="-12dp"
                                    android:layout_marginEnd="-12dp"
                                    android:alpha="0.2"
                                    android:src="@drawable/ic_watermark_task_alt"
                                    android:contentDescription="@null" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/stats_completed_label"
                                        android:textColor="#DAE2FF"
                                        android:textSize="11sp"
                                        android:letterSpacing="0.08"
                                        android:fontFamily="@font/poppins_semibold" />

                                    <TextView
                                        android:id="@+id/tvCompletedCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="#FFFFFF"
                                        android:textSize="32sp"
                                        android:fontFamily="@font/poppins_bold" />

                                    <TextView
                                        android:id="@+id/tvCompletedSubtitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/stats_this_week"
                                        android:textColor="#DAE2FF"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/poppins_regular" />

                                </LinearLayout>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Deep Work Card (Bottom) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDeepWork"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="#105CDB">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="true">

                                <!-- Faded Watermark Timer Icon -->
                                <ImageView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="-12dp"
                                    android:layout_marginEnd="-12dp"
                                    android:alpha="0.2"
                                    android:src="@drawable/ic_priority_flag"
                                    android:contentDescription="@null" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/stats_pending_label"
                                        android:textColor="#DAE2FF"
                                        android:textSize="11sp"
                                        android:letterSpacing="0.08"
                                        android:fontFamily="@font/poppins_semibold" />

                                    <TextView
                                        android:id="@+id/tvPendingCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="#FFFFFF"
                                        android:textSize="32sp"
                                        android:fontFamily="@font/poppins_bold" />

                                    <TextView
                                        android:id="@+id/tvPendingSubtitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/stats_this_week"
                                        android:textColor="#DAE2FF"
                                        android:textSize="13sp"
                                        android:fontFamily="@font/poppins_regular" />

                                </LinearLayout>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <!-- Bento Card 3: Tasks by Priority (Full width)                        -->
                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F0F0F0"
                    app:cardBackgroundColor="@color/surface_container_lowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_tasks_by_priority"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <!-- Include every priority available when creating a task. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/stats_urgent_priority"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_medium" />
                                <TextView
                                    android:id="@+id/tvUrgentPriorityCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 tasks"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="14sp" />
                            </LinearLayout>
                            <ProgressBar
                                android:id="@+id/progressUrgentPriority"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_priority_high" />
                        </LinearLayout>

                        <!-- High Priority Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:text="@string/stats_high_priority"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_medium" />

                                <TextView
                                    android:id="@+id/tvHighPriorityCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="0 tasks"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </RelativeLayout>

                            <ProgressBar
                                android:id="@+id/progressHighPriority"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/progress_priority_high" />
                        </LinearLayout>

                        <!-- Medium Priority Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:text="@string/stats_medium_priority"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_medium" />

                                <TextView
                                    android:id="@+id/tvMediumPriorityCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="0 tasks"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </RelativeLayout>

                            <ProgressBar
                                android:id="@+id/progressMediumPriority"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/progress_priority_medium" />
                        </LinearLayout>

                        <!-- Low Priority Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:text="@string/stats_low_priority"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_medium" />

                                <TextView
                                    android:id="@+id/tvLowPriorityCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="0 tasks"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </RelativeLayout>

                            <ProgressBar
                                android:id="@+id/progressLowPriority"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/progress_priority_low" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <!-- Bento Card 4: Pomodoro Focus (Full width) — Task 15                 -->
                <!-- ═══════════════════════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPomodoroFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F0F0F0"
                    app:cardBackgroundColor="@color/surface_container_lowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvPomodoroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_pomodoro_title"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:id="@+id/tvPomodoroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/stats_pomodoro_subtitle"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular" />

                        <!-- Today / This week totals -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/stats_today_label"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.08"
                                    android:fontFamily="@font/poppins_semibold" />

                                <TextView
                                    android:id="@+id/tvPomodoroToday"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/stats_zero_duration"
                                    android:textColor="@color/on_surface"
                                    android:textSize="24sp"
                                    android:fontFamily="@font/poppins_bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/stats_week_label"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.08"
                                    android:fontFamily="@font/poppins_semibold" />

                                <TextView
                                    android:id="@+id/tvPomodoroWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/stats_zero_duration"
                                    android:textColor="@color/on_surface"
                                    android:textSize="24sp"
                                    android:fontFamily="@font/poppins_bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPomodoroCompleted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/stats_pomodoro_no_sessions"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium" />

                        <!-- Top tasks by focus time -->
                        <LinearLayout
                            android:id="@+id/layoutTopTasks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_top_focus_tasks"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp"
                                android:letterSpacing="0.08"
                                android:fontFamily="@font/poppins_semibold" />

                            <RelativeLayout
                                android:id="@+id/rowTopTask1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:id="@+id/tvTopTask1Name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_toStartOf="@id/tvTopTask1Minutes"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_medium" />

                                <TextView
                                    android:id="@+id/tvTopTask1Minutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/rowTopTask2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:id="@+id/tvTopTask2Name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_toStartOf="@id/tvTopTask2Minutes"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_medium" />

                                <TextView
                                    android:id="@+id/tvTopTask2Minutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/rowTopTask3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:id="@+id/tvTopTask3Name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_toStartOf="@id/tvTopTask3Minutes"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_medium" />

                                <TextView
                                    android:id="@+id/tvTopTask3Minutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </RelativeLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvUnknownCompletionDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/stats_unknown_completion_dates"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
