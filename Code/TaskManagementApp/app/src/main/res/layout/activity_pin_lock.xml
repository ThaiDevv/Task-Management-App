<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_pin_lock.xml — Layout màn hình nhập PIN (TASK-25).

    Cấu trúc (từ trên xuống dưới, khớp với design):
    1. Branding area: icon app + "Welcome Back" + subtitle
    2. PIN indicator area: 4 chấm dot hiển thị số ký tự đã nhập
    3. Keypad: 4 hàng × 3 cột (1-9 + fingerprint/0/backspace)
    4. "Forgot PIN?" link ở dưới cùng
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pinLockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.pin.PinLockActivity">

    <!-- ================================================================ -->
    <!-- 1. BRANDING AREA: App icon + Tiêu đề + Subtitle                  -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/brandingContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="64dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icon app: hình vuông bo góc 18dp, nền trắng, shadow elevation -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_app_icon_container"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <!-- "Welcome Back" — font Poppins Bold 32sp -->
        <TextView
            android:id="@+id/tvWelcomeBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_welcome_back"
            android:textColor="@color/on_surface"
            android:textSize="32sp"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle — font Poppins Regular 16sp, màu on_surface_variant -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_subtitle"
            android:textColor="@color/on_surface_variant"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center" />
    </LinearLayout>

    <!-- ================================================================ -->
    <!-- 2. PIN INDICATOR: 4 chấm tròn hiển thị trạng thái nhập PIN       -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/pinIndicatorContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/brandingContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dot 1 -->
        <View
            android:id="@+id/pinDot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <!-- Dot 2 -->
        <View
            android:id="@+id/pinDot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <!-- Dot 3 -->
        <View
            android:id="@+id/pinDot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <!-- Dot 4 -->
        <View
            android:id="@+id/pinDot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_pin_dot_empty" />
    </LinearLayout>

    <!-- Error message (ẩn mặc định, hiện khi PIN sai hoặc lockout) -->
    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:textColor="@color/error"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="invisible"
        tools:text="Sai PIN. Còn 4 lần thử."
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/pinIndicatorContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================================================================ -->
    <!-- 3. KEYPAD — Đặt ở phần dưới màn hình, push từ bottom lên        -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnForgotPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: 1, 2 (ABC), 3 (DEF) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn1"
                style="@style/Widget.TaskFlow.PinKeypad.Button"
                android:text="@string/pin_key_1" />

            <include
                android:id="@+id/keyBtn2"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="24dp" />

            <include
                android:id="@+id/keyBtn3"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp" />
        </LinearLayout>

        <!-- Row 2: 4 (GHI), 5 (JKL), 6 (MNO) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <include
                android:id="@+id/keyBtn4"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp" />

            <include
                android:id="@+id/keyBtn5"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="24dp" />

            <include
                android:id="@+id/keyBtn6"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp" />
        </LinearLayout>

        <!-- Row 3: 7 (PQRS), 8 (TUV), 9 (WXYZ) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <include
                android:id="@+id/keyBtn7"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp" />

            <include
                android:id="@+id/keyBtn8"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="24dp" />

            <include
                android:id="@+id/keyBtn9"
                layout="@layout/item_pin_key_with_letters"
                android:layout_width="72dp"
                android:layout_height="72dp" />
        </LinearLayout>

        <!-- Row 4: Fingerprint | 0 | Backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Fingerprint button (icon only, no background) -->
            <ImageButton
                android:id="@+id/btnFingerprint"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_fingerprint"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pin_biometric"
                android:padding="20dp" />

            <!-- Key 0 (with background, same as 1–9) -->
            <Button
                android:id="@+id/btn0"
                style="@style/Widget.TaskFlow.PinKeypad.Button"
                android:text="@string/pin_key_0"
                android:layout_marginHorizontal="24dp" />

            <!-- Backspace button (icon only, no background) -->
            <ImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_backspace"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pin_backspace"
                android:padding="20dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================================================================ -->
    <!-- 4. FORGOT PIN? — Link text ở dưới cùng                          -->
    <!-- ================================================================ -->
    <Button
        android:id="@+id/btnForgotPin"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/pin_forgot"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
