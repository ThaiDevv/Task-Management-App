<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Top Branding Area -->
    <LinearLayout
        android:id="@+id/brandingContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="64dp"
        android:paddingBottom="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Logo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="12dp"
                android:src="@drawable/ic_launcher_foreground"
                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textColor="@color/on_surface"
            android:textSize="32sp"
            tools:text="Welcome Back" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@style/TextAppearance.Material3.BodyMedium"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:textColor="@color/on_surface_variant"
            tools:text="Enter your PIN to access TaskFlow" />

    </LinearLayout>

    <!-- PIN Dots Container -->
    <LinearLayout
        android:id="@+id/pinDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandingContainer">

        <View
            android:id="@+id/pinDot1"
            style="@style/PinDotStyle" />

        <View
            android:id="@+id/pinDot2"
            style="@style/PinDotStyle" />

        <View
            android:id="@+id/pinDot3"
            style="@style/PinDotStyle" />

        <View
            android:id="@+id/pinDot4"
            style="@style/PinDotStyle" />

    </LinearLayout>

    <!-- Error Text -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/error"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pinDotsContainer"
        tools:text="Incorrect PIN. Try again."
        tools:visibility="visible" />

    <!-- Lockout Container (shown during 30s lockout) -->
    <LinearLayout
        android:id="@+id/lockoutContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/keypadContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandingContainer"
        tools:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_settings_lock"
            app:tint="@color/on_surface_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@style/TextAppearance.Material3.TitleMedium"
            android:text="@string/pin_lockout_title"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/lockoutTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/on_surface_variant"
            tools:text="Try again in 25 seconds" />

    </LinearLayout>

    <!-- Keypad Container -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@id/forgotPinButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pinDotsContainer"
        app:layout_constraintVertical_bias="0.5">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                style="@style/KeypadButtonStyle"
                android:layout_marginEnd="24dp"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                style="@style/KeypadButtonStyle"
                android:layout_marginEnd="24dp"
                android:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                style="@style/KeypadButtonStyle"
                android:text="3" />

        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn4"
                style="@style/KeypadButtonStyle"
                android:layout_marginEnd="24dp"
                android:text="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn5"
                style="@style/KeypadButtonStyle"
                android:layout_marginEnd="24dp"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn6"
                style="@style/KeypadButtonStyle"
                android:text="6" />

        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn7"
                style="@style/KeypadButtonStyle"
                android:layout_marginEnd="24dp"
                android:text="7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn8"
                style="@style/KeypadButtonStyle"
                android:layout_marginEnd="24dp"
                android:text="8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn9"
                style="@style/KeypadButtonStyle"
                android:text="9" />

        </LinearLayout>

        <!-- Row 4: Biometric, 0, Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBiometric"
                style="@style/KeypadButtonStyle.Transparent"
                android:layout_marginEnd="24dp"
                android:visibility="gone"
                app:icon="@drawable/ic_fingerprint"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp"
                app:iconTint="@color/on_surface_variant" />

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="24dp"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn0"
                style="@style/KeypadButtonStyle"
                android:layout_marginEnd="24dp"
                android:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/KeypadButtonStyle.Transparent"
                app:icon="@drawable/ic_backspace"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp"
                app:iconTint="@color/on_surface_variant" />

        </LinearLayout>

    </LinearLayout>

    <!-- Forgot PIN Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/forgotPinButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:fontFamily="@style/TextAppearance.Material3.BodyMedium"
        android:text="@string/pin_forgot"
        android:textColor="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
