<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.detail.TaskDetailActivity">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TaskFlow"
                    android:textAppearance="@style/TextAppearance.TaskManagementApp.HeadlineMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/spacing_16"
                    android:src="@android:drawable/ic_popup_reminder"
                    android:contentDescription="Notifications"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvUserAvatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_priority"
                    android:gravity="center"
                    android:text="JD"
                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:orientation="horizontal">

                <!-- Priority Badge -->
                <TextView
                    android:id="@+id/tvPriorityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:background="@drawable/bg_badge_priority"
                    android:drawableStart="@android:drawable/ic_dialog_alert"
                    android:drawablePadding="4dp"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingTop="@dimen/spacing_4"
                    android:paddingEnd="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelMedium"
                    tools:text="High Priority" />

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_status"
                    android:drawableStart="@android:drawable/ic_popup_sync"
                    android:drawablePadding="4dp"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingTop="@dimen/spacing_4"
                    android:paddingEnd="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelMedium"
                    tools:text="In Progress" />

            </LinearLayout>

            <!-- Task Title -->
            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24"
                android:textAppearance="@style/TextAppearance.TaskManagementApp.DisplayMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Finalize Project Proposal" />

            <!-- Bento Grid Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="3">

                <!-- Left Column: Description Card (col-span-2) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_marginEnd="@dimen/spacing_12"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorSurfaceContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_24">

                            <!-- Description Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="@dimen/spacing_12">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="@dimen/spacing_8"
                                    android:src="@android:drawable/ic_menu_info_details"
                                    app:tint="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Description"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.HeadlineMedium"
                                    android:textColor="?attr/colorPrimary" />

                            </LinearLayout>

                            <!-- Description Text -->
                            <TextView
                                android:id="@+id/tvDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_16"
                                android:textAppearance="@style/TextAppearance.TaskManagementApp.BodyLarge"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Review and finalize the final version of the project proposal before submitting it to the executive team." />

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/spacing_8"
                                android:layout_marginBottom="@dimen/spacing_16"
                                android:background="?attr/colorSurfaceContainer" />

                            <!-- Due Date Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="@dimen/spacing_16">

                                <View
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="@dimen/spacing_12"
                                    android:background="@drawable/bg_badge_priority" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="DUE DATE"
                                        android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/tvDueDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.TaskManagementApp.HeadlineMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="Oct 25, 2023" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Scheduled Time Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="@dimen/spacing_12"
                                    android:background="@drawable/bg_badge_status" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SCHEDULED TIME"
                                        android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/tvScheduledTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.TaskManagementApp.HeadlineMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="10:00 AM" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Right Column: Sidebar Cards (col-span-1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Reminder Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorSurfaceContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="@dimen/spacing_8">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="@dimen/spacing_4"
                                    android:src="@android:drawable/ic_popup_reminder"
                                    app:tint="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="REMINDER"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                    android:textColor="?attr/colorPrimary"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvReminder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 mins before"
                                android:textAppearance="@style/TextAppearance.TaskManagementApp.HeadlineMedium"
                                android:textColor="?attr/colorOnSurface" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Recurrence Card (Blue) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRecurrence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="@dimen/spacing_8">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="@dimen/spacing_4"
                                    android:src="@android:drawable/ic_popup_sync"
                                    app:tint="?attr/colorOnPrimaryContainer" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="RECURRENCE"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvRecurrenceType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_8"
                                android:text="Weekly"
                                android:textAppearance="@style/TextAppearance.TaskManagementApp.HeadlineMedium"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <!-- Day Selector -->
                            <LinearLayout
                                android:id="@+id/layoutDaySelector"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvDayM"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="@dimen/spacing_4"
                                    android:background="@drawable/bg_badge_priority"
                                    android:gravity="center"
                                    android:text="M"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDayT"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="@dimen/spacing_4"
                                    android:background="@drawable/bg_badge_priority"
                                    android:gravity="center"
                                    android:text="T"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDayW"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="@dimen/spacing_4"
                                    android:background="@drawable/bg_badge_priority"
                                    android:gravity="center"
                                    android:text="W"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDayTh"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="@dimen/spacing_4"
                                    android:background="@drawable/bg_badge_priority"
                                    android:gravity="center"
                                    android:text="T"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDayF"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_badge_priority"
                                    android:gravity="center"
                                    android:text="F"
                                    android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Attachment Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAttachment"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivAttachment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_background"
                            android:contentDescription="Attachment preview" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/gradient_attachment_overlay" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📎 1 Attachment"
                                android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelSmall"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:id="@+id/tvAttachmentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Project_Draft_V4.pdf"
                                android:textAppearance="@style/TextAppearance.TaskManagementApp.BodyLarge"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:orientation="vertical">

                <!-- Edit + Delete Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEdit"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:text="@string/task_detail_button_edit"
                        android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelMedium"
                        app:cornerRadius="@dimen/radius_medium"
                        app:icon="@android:drawable/ic_menu_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelete"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:text="@string/task_detail_button_delete"
                        android:textAppearance="@style/TextAppearance.TaskManagementApp.LabelMedium"
                        android:textColor="?attr/colorError"
                        app:cornerRadius="@dimen/radius_medium"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconTint="?attr/colorError"
                        app:strokeColor="?attr/colorError" />

                </LinearLayout>

                <!-- Mark as Completed Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnComplete"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/task_detail_button_complete"
                    android:textAppearance="@style/TextAppearance.TaskManagementApp.HeadlineMedium"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    app:cornerRadius="@dimen/radius_medium"
                    app:icon="@android:drawable/checkbox_on_background"
                    app:iconTint="?attr/colorOnPrimaryContainer" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Mobile FAB for Quick Complete -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_24"
        android:contentDescription="Mark as completed"
        android:src="@android:drawable/checkbox_on_background"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
