<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.RewardsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Title Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.01"
                android:text="Rewards &amp; Badges"
                android:textColor="#1B1B1B"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Complete daily tasks to maintain your streak and unlock milestone badges!"
                android:textColor="#737786"
                android:textSize="13sp" />

            <!-- Summary Cards: Unlocked Badges & Current Rank -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#4DC3C6D7"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:letterSpacing="0.05"
                            android:text="BADGES UNLOCKED"
                            android:textColor="#737786"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvUnlockedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="0 / 14"
                            android:textColor="#10B981"
                            android:textSize="24sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#4DC3C6D7"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:letterSpacing="0.05"
                            android:text="CURRENT TITLE"
                            android:textColor="#737786"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvCurrentRank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Beginner"
                            android:textColor="#105CDB"
                            android:textSize="20sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Milestone Badges List Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#4DC3C6D7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/streak_milestones_header"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <!-- Badge 1: 3 Days -->
                    <LinearLayout
                        android:id="@+id/layoutBadge3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/streak_milestone_3"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvStatus3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Locked 🔒"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 2: 7 Days -->
                    <LinearLayout
                        android:id="@+id/layoutBadge7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/streak_milestone_7"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvStatus7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Locked 🔒"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 3: 30 Days -->
                    <LinearLayout
                        android:id="@+id/layoutBadge30"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/streak_milestone_30"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvStatus30"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Locked 🔒"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 4: 50 Days -->
                    <LinearLayout
                        android:id="@+id/layoutBadge50"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/streak_milestone_50"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvStatus50"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Locked 🔒"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 5: 100 Days -->
                    <LinearLayout
                        android:id="@+id/layoutBadge100"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/streak_milestone_100"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvStatus100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Locked 🔒"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 6: 200 Days -->
                    <LinearLayout
                        android:id="@+id/layoutBadge200"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/streak_milestone_200"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvStatus200"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Locked 🔒"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 7: 365 Days -->
                    <LinearLayout
                        android:id="@+id/layoutBadge365"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_pill_outlined"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/streak_milestone_365"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvStatus365"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Locked 🔒"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Task Completion Rewards Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#4DC3C6D7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/task_milestones_header"
                        android:textColor="#1B1B1B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTaskProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#737786"
                        android:textSize="12sp"
                        tools:text="Completed: 12 tasks" />

                    <!-- Badge 1: 10 Tasks -->
                    <LinearLayout
                        android:id="@+id/layoutTaskBadge10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/task_milestone_10"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTaskStatus10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/badge_locked"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 2: 50 Tasks -->
                    <LinearLayout
                        android:id="@+id/layoutTaskBadge50"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/task_milestone_50"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTaskStatus50"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/badge_locked"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 3: 100 Tasks -->
                    <LinearLayout
                        android:id="@+id/layoutTaskBadge100"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/task_milestone_100"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTaskStatus100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/badge_locked"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 4: 250 Tasks -->
                    <LinearLayout
                        android:id="@+id/layoutTaskBadge250"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/task_milestone_250"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTaskStatus250"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/badge_locked"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 5: 500 Tasks -->
                    <LinearLayout
                        android:id="@+id/layoutTaskBadge500"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/task_milestone_500"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTaskStatus500"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/badge_locked"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 6: 1000 Tasks -->
                    <LinearLayout
                        android:id="@+id/layoutTaskBadge1000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_outlined"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/task_milestone_1000"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTaskStatus1000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/badge_locked"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge 7: 2000 Tasks -->
                    <LinearLayout
                        android:id="@+id/layoutTaskBadge2000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_outlined"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/task_milestone_2000"
                            android:textColor="#1B1B1B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTaskStatus2000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/badge_locked"
                            android:textColor="#737786"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
