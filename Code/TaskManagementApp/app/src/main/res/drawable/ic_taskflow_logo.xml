<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_taskflow_logo.xml — TaskFlow Official Brand Logo.
    Design: Circular ring with an energetic checkmark extending past the top-right edge.
    Brand Gradient: #105CDB (Primary Blue) to #3A97FE (Action Blue).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 1. Circular Ring -->
    <path
        android:pathData="M512,512m-294,0a294,294 0,1 1,588 0a294,294 0,1 1,-588 0"
        android:strokeWidth="90">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="218"
                android:startY="806"
                android:endX="806"
                android:endY="218">
                <item android:offset="0.0" android:color="#105CDB" />
                <item android:offset="0.6" android:color="#1A81F4" />
                <item android:offset="1.0" android:color="#3A97FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Stylized Checkmark -->
    <path
        android:pathData="M358,468L500,640L778,272"
        android:strokeWidth="100"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="358"
                android:startY="640"
                android:endX="778"
                android:endY="272">
                <item android:offset="0.0" android:color="#105CDB" />
                <item android:offset="0.5" android:color="#1A81F4" />
                <item android:offset="1.0" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
