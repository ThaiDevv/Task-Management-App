<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_taskflow_logo.xml — TaskFlow logo vector dùng trong giao diện app.
    (Khác với ic_launcher_foreground: viewport nhỏ hơn, dùng được ở nhiều kích thước)

    Dùng trong:
    - activity_pin_lock.xml → ivAppIcon
    - Toolbar (nếu cần)
    - Màn hình Splash (nếu có)

    Viewport: 100×100 — logo nằm trong vùng safe area
    Gradient: #55BCFD → #2563EB → #1A40B8
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- ============================================================ -->
    <!-- 1. Outer rounded-square ring frame                           -->
    <!--    Dùng evenOdd fill với 2 rounded rect lồng nhau           -->
    <!-- ============================================================ -->
    <path
        android:pathData="
        M 16,32
        C 16,23.16 23.16,16 32,16
        L 68,16
        C 76.84,16 84,23.16 84,32
        L 84,68
        C 84,76.84 76.84,84 68,84
        L 32,84
        C 23.16,84 16,76.84 16,68
        Z
        M 32,21.5
        C 26.2,21.5 21.5,26.2 21.5,32
        L 21.5,68
        C 21.5,73.8 26.2,78.5 32,78.5
        L 68,78.5
        C 73.8,78.5 78.5,73.8 78.5,68
        L 78.5,32
        C 78.5,26.2 73.8,21.5 68,21.5
        Z"
        android:fillType="evenOdd">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="16"
                android:endX="84"
                android:endY="84">
                <item android:offset="0.0"  android:color="#55BCFD" />
                <item android:offset="0.5"  android:color="#2563EB" />
                <item android:offset="1.0"  android:color="#1A40B8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ============================================================ -->
    <!-- 2. Stylized checkmark — Geometric zigzag path               -->
    <!--    Phản ánh logo gốc: góc cứng, không cong                  -->
    <!-- ============================================================ -->
    <path
        android:pathData="
        M 28,66
        L 36,52
        L 45,61
        L 56,36
        L 64,47
        L 53,68
        L 44,59
        L 38,71
        Z"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="36"
                android:endX="70"
                android:endY="72">
                <item android:offset="0.0"  android:color="#55BCFD" />
                <item android:offset="0.55" android:color="#2563EB" />
                <item android:offset="1.0"  android:color="#1A40B8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ============================================================ -->
    <!-- 3. Arrow — Pointing upper-right, breaking out of the frame  -->
    <!--    Hình mũi tên: thân (stroke dày) + đầu mũi               -->
    <!-- ============================================================ -->
    <!-- Arrow body + head (filled polygon) -->
    <path
        android:pathData="
        M 54,47
        L 71,30
        L 71,40
        L 80,40
        L 80,21
        L 61,21
        L 61,30
        L 71,30
        L 54,47
        Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="47"
                android:endX="80"
                android:endY="21">
                <item android:offset="0.0"  android:color="#2563EB" />
                <item android:offset="1.0"  android:color="#55BCFD" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
