<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state → solid primary fill (matches reference: bg-primary) -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="#0045AE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Checked fallback -->
    <item android:state_checked="true">
        <shape>
            <solid android:color="#0045AE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default: white bg + outline-variant border (matches reference: border border-outline-variant) -->
    <item>
        <shape>
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#C3C6D7" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
